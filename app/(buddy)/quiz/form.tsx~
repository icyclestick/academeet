import {View, Text, TouchableOpacity, Alert, ScrollView, KeyboardAvoidingView, Platform} from 'react-native'
import {useState, useEffect} from 'react'
import {router} from "expo-router";
import BackButton from "@/components/BackButton";
import DropDownPicker from 'react-native-dropdown-picker';
import {accountabilityOptions, matchOptions, timeOptions, yearOptions} from "@/types/DropDownOptions";
import {useAuth} from "@/providers/AuthProviders";
import {supabase} from "@/lib/supabase";
import { useUniversitiesAndMajors } from '@/hooks/useUniversitiesAndMajors';
import type { DropdownOption } from '@/types/Supabase';

const Form = () => {
    const {profile} = useAuth()
    const [loading, setLoading] = useState(false);

    const [yearOpen, setYearOpen] = useState(false);
    const [yearValue, setYearValue] = useState(null);
    const [yearItems, setYearItems] = useState<DropdownOption[]>(yearOptions);

    const [timeOpen, setTimeOpen] = useState(false);
    const [timeValue, setTimeValue] = useState(null);
    const [timeItems, setTimeItems] = useState<DropdownOption[]>(timeOptions);

    const [accountOpen, setAccountOpen] = useState(false);
    const [accountValue, setAccountValue] = useState(null);
    const [accountItems, setAccountItems] = useState<DropdownOption[]>(accountabilityOptions);

    const [matchOpen, setMatchOpen] = useState(false);
    const [matchValue, setMatchValue] = useState(null);
    const [matchItems, setMatchItems] = useState<DropdownOption[]>(matchOptions);

    const [majorOpen, setMajorOpen] = useState(false);
    const [majorValue, setMajorValue] = useState(null);
    const [majorItems, setMajorItems] = useState<DropdownOption[]>([]);
    const [universityOpen, setUniversityOpen] = useState(false);
    const [universityValue, setUniversityValue] = useState(null);
    const [universityItems, setUniversityItems] = useState<DropdownOption[]>([]);

    const { universities, majors, loading: loadingDropdowns } = useUniversitiesAndMajors();

    useEffect(() => {
        setUniversityItems(universities);
        setMajorItems(majors);
    }, [universities, majors]);

    const handleSubmitPreferences = async () => {
        if (!yearValue || !timeValue || !accountValue || !matchValue || !universityValue || !majorValue) {
            Alert.alert('Please fill in all fields');
            return;
        }

        const preferences = {
            yearLevel: yearValue,
            studyTime: timeValue,
            accountability: accountValue,
            matchPreference: matchValue,
            major: majorValue.id, // This is now the major's id (fod1p)
        };

        setLoading(true);

        // 1. Update preferences and university by ID in 'profiles'
        const { error: updateError } = await supabase
            .from('profiles')
            .update({ preferences: preferences, university: universityValue.id }) // universityValue is now the university id
            .eq('id', profile.id);

        if (updateError) {
            console.error(updateError);
            Alert.alert('Error saving preferences');
            setLoading(false);
            return;
        }

        // 2. Insert into 'looking_match'
        const { error: insertError } = await supabase
            .from('looking_match')
            .insert([{ user_id: profile.id }]);

        if (insertError) {
            console.error(insertError);
            Alert.alert('Error adding to match queue');
            setLoading(false)
        } else {
            Alert.alert('Successfully updated preferences and joined match queue');
            router.push('/(buddy)/waitingRoom');
        }

        setLoading(false);
    };

    return (
        <KeyboardAvoidingView
            style={{ flex: 1 }}
            behavior={Platform.OS === 'ios' ? 'padding' : undefined}
            keyboardVerticalOffset={80}
        >
            <ScrollView
                style={{ flex: 1, backgroundColor: 'white', overflow: 'visible' }}
                contentContainerStyle={{ paddingHorizontal: 24, paddingVertical: 32, overflow: 'visible' }}
                keyboardShouldPersistTaps="handled"
            >
                <View className="gap-10" style={{ overflow: 'visible' }}>
                    <View style={{ overflow: 'visible' }}>
                        <BackButton />

                        <Text className="text-englishViolet text-2xl font-bold">
                            Studying is better together. Let’s find your perfect match!
                        </Text>
                    </View>
                    <View className="gap-2" style={{ zIndex: 4000, overflow: 'visible' }}>
                        <Text className="font-bold">Year Level</Text>
                        <DropDownPicker
                            placeholder="Select Year Level"
                            open={yearOpen}
                            value={yearValue}
                            items={yearItems}
                            setOpen={setYearOpen}
                            setValue={setYearValue}
                            setItems={setYearItems}
                            placeholderStyle={{ color: 'gray' }}
                            style={{ borderColor: '#D3D3D3' }}
                            dropDownContainerStyle={{ borderColor: '#D3D3D3' }}
                            zIndex={4000}
                            listMode="SCROLLVIEW"
                        />
                    </View>
                    <View className="gap-2" style={{ zIndex: 3000, overflow: 'visible' }}>
                        <Text className="font-bold">Study Time Preference</Text>
                        <DropDownPicker
                            placeholder="Preferred Study Time"
                            open={timeOpen}
                            value={timeValue}
                            items={timeItems}
                            setOpen={setTimeOpen}
                            setValue={setTimeValue}
                            setItems={setTimeItems}
                            placeholderStyle={{ color: 'gray' }}
                            style={{ borderColor: '#D3D3D3' }}
                            dropDownContainerStyle={{ borderColor: '#D3D3D3' }}
                            zIndex={3000}
                            listMode="SCROLLVIEW"
                        />
                    </View>
                    <View className="gap-2" style={{ zIndex: 2000, overflow: 'visible' }}>
                        <Text className="font-bold">Accountability Level</Text>
                        <DropDownPicker
                            placeholder="Accountability Level"
                            open={accountOpen}
                            value={accountValue}
                            items={accountItems}
                            setOpen={setAccountOpen}
                            setValue={setAccountValue}
                            setItems={setAccountItems}
                            placeholderStyle={{ color: 'gray' }}
                            style={{ borderColor: '#9E9C9D' }}
                            dropDownContainerStyle={{ borderColor: '#D3D3D3' }}
                            zIndex={2000}
                            listMode="SCROLLVIEW"
                        />
                    </View>
                    <View className="gap-2" style={{ zIndex: 1000, overflow: 'visible' }}>
                        <Text className="font-bold">Match Preference</Text>
                        <DropDownPicker
                            placeholder="Match Preference"
                            open={matchOpen}
                            value={matchValue}
                            items={matchItems}
                            setOpen={setMatchOpen}
                            setValue={setMatchValue}
                            setItems={setMatchItems}
                            placeholderStyle={{ color: 'gray' }}
                            style={{ borderColor: '#9E9C9D' }}
                            dropDownContainerStyle={{ borderColor: '#D3D3D3' }}
                            zIndex={1000}
                            listMode="SCROLLVIEW"
                        />
                    </View>
                    <View className="gap-2 mb-4" style={{ zIndex: 900, overflow: 'visible' }}>
                        <Text className="font-bold">University</Text>
                        <DropDownPicker
                            placeholder="Select your university"
                            open={universityOpen}
                            value={universityValue}
                            items={universityItems}
                            setOpen={setUniversityOpen}
                            setValue={setUniversityValue}
                            setItems={setUniversityItems}
                            searchable={true}
                            loading={loadingDropdowns}
                            placeholderStyle={{ color: 'gray' }}
                            style={{ borderColor: '#D3D3D3' }}
                            dropDownContainerStyle={{ borderColor: '#D3D3D3' }}
                            zIndex={1200}
                            listMode="SCROLLVIEW"
                        />
                    </View>
                    <View className="gap-2 mb-4" style={{ zIndex: 800, overflow: 'visible' }}>
                        <Text className="font-bold">Major</Text>
                        <DropDownPicker
                            placeholder="Select your major"
                            open={majorOpen}
                            value={majorValue}
                            items={majorItems}
                            setOpen={setMajorOpen}
                            setValue={setMajorValue}
                            setItems={setMajorItems}
                            searchable={true}
                            loading={loadingDropdowns}
                            placeholderStyle={{ color: 'gray' }}
                            style={{ borderColor: '#D3D3D3' }}
                            dropDownContainerStyle={{ borderColor: '#D3D3D3' }}
                            zIndex={2000}
                            listMode="SCROLLVIEW"
                            dropDownDirection="BOTTOM"
                        />
                    </View>

                    <View style={{ height: 40 }} />
                    <TouchableOpacity
                        className="bg-englishViolet rounded-full py-4 mx-6 mt-10"
                        disabled={loading}
                        onPress={handleSubmitPreferences}
                    >
                        <Text className="text-white text-center font-semibold">Find a Study Buddy</Text>
                    </TouchableOpacity>
                </View>
            </ScrollView>
        </KeyboardAvoidingView>
    )
}
export default Form
